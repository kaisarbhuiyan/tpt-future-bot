# =============================================================
# TPT FUTURE BOT — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# Add .env to your .gitignore.
# =============================================================

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./tpt_bot.db

# ---------------------------------------------------------------
# FASTAPI SERVER
# ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-long-random-secret-string

# ---------------------------------------------------------------
# LIVE TRADING GATE — SAFETY GATE #1 OF 2
# ---------------------------------------------------------------
# Set to "true" ONLY after ALL of the following are satisfied:
#   1. All values in config/rules.yaml verified with TPT dashboard
#   2. config/rules.yaml → live_trading.live_trading_confirmed = true
#   3. Tradovate API credentials filled in below
#   4. Paper trading tested for minimum 5 trading days
#   5. You accept full financial responsibility for live trading
#
# BOTH this env var AND the config flag must be true to enable live.
# Default: false (paper trading mode)
# ---------------------------------------------------------------
ENABLE_LIVE_TRADING=false

# ---------------------------------------------------------------
# TRADOVATE API CREDENTIALS
# Only required when ENABLE_LIVE_TRADING=true
# Get credentials from: https://trader.tradovate.com → API Access
# ---------------------------------------------------------------
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=
TRADOVATE_CID=
TRADOVATE_SECRET=
# Environment: "demo" for sim/paper via Tradovate, "live" for real money
# Start with "demo" even when testing live connection
TRADOVATE_ENV=demo

# ---------------------------------------------------------------
# MARKET DATA
# yfinance is used by default (free, 15-min delayed for paper mode)
# For real-time paper trading data, use Polygon.io
# ---------------------------------------------------------------
POLYGON_API_KEY=

# ---------------------------------------------------------------
# NEWS FILTER (optional)
# Used for blocking trades during high-impact economic events
# Leave blank to disable news filtering
# Supported: Tradingeconomics, ForexFactory (manual import)
# ---------------------------------------------------------------
ECONOMIC_CALENDAR_API_KEY=

# ---------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
